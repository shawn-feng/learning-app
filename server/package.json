{
  "name": "learning-server",
  "version": "0.1.2",
  "description": "学习伙伴服务端：数据唯一真源 + 认证代理 + materials/大文件（SPLIT 架构）",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
