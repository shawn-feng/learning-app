# 权益认证中台 环境变量
# 复制本文件为 .env 放到服务器 /opt/benefit-auth/.env（已被 .gitignore 忽略，切勿提交）
# systemd 服务通过 EnvironmentFile=/opt/benefit-auth/.env 读取

# JWT 签名密钥：务必改为强随机值（例如 openssl rand -hex 32）
BENEFIT_JWT_SECRET=change-me-to-a-strong-random-secret

# 本站公网地址（用于构造抖音回调与 Cookie 安全标记）
PUBLIC_BASE_URL=https://auth.aixuexihao.top
# Cookie 是否 Secure：auto=按 PUBLIC_BASE_URL 是否 https 自动判断；可显式 true/false
COOKIE_SECURE=auto

# ---------------- 抖音开放平台 ----------------
# 在 https://open.douyin.com 创建应用，回调域名填 https://auth.aixuexihao.top
# 并把下方两个值填到「应用信息 / 凭证」
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_API_BASE=https://open.douyin.com
# 如需让用户授权网站读取其视频，应用需额外申请 video.list 等 scope（在开放平台后台开通）

# ---------------- 后续平台（按需启用，新增 Provider 见 app/platforms/） ----------------
# WECHAT_CLIENT_ID=
# WECHAT_CLIENT_SECRET=
# XHS_CLIENT_ID=
# XHS_CLIENT_SECRET=
