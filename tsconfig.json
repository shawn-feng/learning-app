{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "outDir": "out",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@electron/*": ["./electron/*"]
    }
  },
  "include": ["electron/**/*", "src/**/*"],
  "exclude": ["node_modules", "out", "cloud-service"]
}
